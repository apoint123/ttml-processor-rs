<tt xmlns="http://www.w3.org/ns/ttml" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" itunes:timing="Line" xml:lang="en">
    <head>
        <metadata>
            <ttm:agent type="person" xml:id="v1"/>
            <ttm:agent type="person" xml:id="v2"/>
            <ttm:agent type="person" xml:id="v3"/>
            <ttm:agent type="group" xml:id="v4"/>
            <ttm:agent type="person" xml:id="v5"/>
            <ttm:agent type="person" xml:id="v6"/>
            <ttm:agent type="person" xml:id="v7"/>
            <ttm:agent type="person" xml:id="v8"/>
            <ttm:agent type="person" xml:id="v9"/>
            <ttm:agent type="person" xml:id="v10"/>
            <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
                <songwriters>
                    <songwriter>Lin-Manuel Miranda</songwriter>
                </songwriters>
