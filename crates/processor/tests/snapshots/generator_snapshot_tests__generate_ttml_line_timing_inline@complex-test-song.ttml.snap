    <body dur="25.000">
        <div begin="10.000" end="17.000" itunes:songPart="Verse">
            <p begin="10.000" end="12.000" itunes:key="L1" ttm:agent="v1">これは テスト<span ttm:role="x-translation" xml:lang="en-US">This is the first line (Vocalist A)</span>
