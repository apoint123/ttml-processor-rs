	"lines": [
		{
			"text": "說不上為什麼 我變得很主動",
			"startTime": 26663,
			"endTime": 31477,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "说不上为什么 我变得很主动"
				}
			],
			"romanizations": [
				{
					"language": "zh-Latn-pinyin",
					"text": "shuo bu shang wei shen me wo bian de hen zhu dong"
				}
			],
			"id": "L1",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 1
		},
		{
			"text": "若愛上一個人 什麼都會值得去做",
			"startTime": 31673,
			"endTime": 36245,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "若爱上一个人 什么都会值得去做"
				}
			],
			"romanizations": [
				{
					"language": "zh-Latn-pinyin",
					"text": "ruo ai shang yi ge ren shen me du hui zhi de qu zuo"
				}
			],
			"id": "L2",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 1
		},
		{
			"text": "我想大聲宣佈 對妳依依不捨",
			"startTime": 36622,
			"endTime": 41280,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "我想大声宣布 对你依依不舍"
				}
			],
			"romanizations": [
				{
					"language": "zh-Latn-pinyin",
					"text": "wo xiang da sheng xuan bu dui ni yi yi bu she"
				}
			],
			"id": "L3",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 1
		},
		{
			"text": "連隔壁鄰居都 猜到我現在的感受",
