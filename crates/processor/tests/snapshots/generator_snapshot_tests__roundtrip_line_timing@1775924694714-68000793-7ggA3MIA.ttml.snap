				{
					"language": "es",
					"text": "El aire primaveral sopla fuera de la habitación"
				},
				{
					"language": "fr",
					"text": "Le printemps fleurit par la fenêtre"
				},
				{
					"language": "id",
					"text": "Musim semi di luar jendela"
				},
				{
					"language": "ja",
					"text": "窓の外は春"
