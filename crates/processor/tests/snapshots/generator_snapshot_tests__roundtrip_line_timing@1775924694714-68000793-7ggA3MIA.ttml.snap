		{
			"text": "或许该学着石头忘却世界",
			"startTime": 130760,
			"endTime": 134570,
			"translations": [
				{
					"language": "de",
					"text": "Zeit, den Kopf in den Sand zu stecken und die Welt zu vergessen."
				},
				{
