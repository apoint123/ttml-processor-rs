		{
			"text": "停在枝头的麻雀",
			"startTime": 15080,
			"endTime": 18570,
			"translations": [
				{
					"language": "de",
					"text": "und ein Spatz sitzt sanft auf einem Zweig."
				},
				{
					"language": "en",
					"text": "A sparrow perched on a branch"
