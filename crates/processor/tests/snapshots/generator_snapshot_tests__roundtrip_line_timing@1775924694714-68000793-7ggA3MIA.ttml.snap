		{
			"text": "窗外的春天",
			"startTime": 10640,
			"endTime": 13820,
			"translations": [
				{
					"language": "de",
					"text": "erblühen die Frühlingsblumen gerade außerhalb,"
				},
				{
					"language": "en",
					"text": "The springtime blooming just outside"
