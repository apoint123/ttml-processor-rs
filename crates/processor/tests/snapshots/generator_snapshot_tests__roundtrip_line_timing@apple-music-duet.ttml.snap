		},
		{
			"text": "Bruno says, \"It looks like rain\"",
			"startTime": 182369,
			"endTime": 188505,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "布鲁诺说 看来要下雨"
				}
			],
			"id": "L50",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 12
		},
		{
			"text": "Why did he tell us?",
			"startTime": 185208,
			"endTime": 187659,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "他为何说出来"
				}
			],
			"id": "L51",
			"agentId": "v3",
			"songPart": "Verse",
			"blockIndex": 12
		},
		{
			"text": "In doing so, he floods my brain",
			"startTime": 186739,
			"endTime": 191072,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "那样做让我心绪难宁"
				}
			],
			"id": "L52",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 12
		},
		{
			"text": "Married in a hurricane",
			"startTime": 191101,
			"endTime": 196446,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "在狂风骤雨的天气结婚"
				}
			],
			"id": "L53",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 12
		},
		{
			"text": "He's here",
			"startTime": 196053,
			"endTime": 196986,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "他来了"
				}
			],
			"id": "L54",
			"agentId": "v4",
			"songPart": "Verse",
			"blockIndex": 12
		},
		{
			"text": "Don't talk about Bruno",
			"startTime": 196935,
			"endTime": 200359,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "不提布鲁诺"
				}
			],
			"id": "L55",
			"agentId": "v4",
			"songPart": "Outro",
			"blockIndex": 13
		},
		{
			"text": "Why did I talk about Bruno?",
			"startTime": 198973,
			"endTime": 202348,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "我为何提起布鲁诺"
				}
			],
			"id": "L56",
			"agentId": "v9",
			"songPart": "Outro",
			"blockIndex": 13
		},
		{
			"text": "Not a word about Bruno",
			"startTime": 201602,
			"endTime": 205212,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "绝口不提布鲁诺"
				}
			],
			"id": "L57",
			"agentId": "v4",
			"songPart": "Outro",
			"blockIndex": 13
		},
		{
			"text": "I never shoulda brought up Bruno",
			"startTime": 203215,
			"endTime": 206128,
			"translations": [
				{
					"language": "zh-Hans",
					"text": "我真不该提起布鲁诺"
