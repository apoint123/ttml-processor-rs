			"translations": [
				{
					"language": "en",
					"text": "I’m overflowing with insanity, how can I stop?"
				},
				{
					"language": "zh-Hans",
					"text": "渐渐地被陷入疯狂 无论怎样也无法抑止"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "kyo u ki mi chi te i ku wa do u su re ba to ma ru no"
				}
			],
			"id": "L135",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 13
		},
		{
			"text": "この気持ち壊れて どこへ辿り着くのでしょうか",
			"startTime": 270350,
			"endTime": 276480,
			"translations": [
				{
					"language": "en",
					"text": "Where will I make my way to when my feelings break down?"
				},
				{
					"language": "zh-Hans",
					"text": "心情都被毁坏 接著该如何是好"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "ko no ki mo chi ko wa re te do ko e ta do ri tsu ku no de sho u ka"
				}
			],
			"id": "L136",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 13
		},
		{
			"text": "愛溢れて行くわ 止めることはできない…",
			"startTime": 276790,
			"endTime": 283300,
			"translations": [
				{
					"language": "en",
					"text": "My love is overflowing, I can’t stop it..."
				},
				{
					"language": "zh-Hans",
					"text": "爱就要满溢出来 无法停止……"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "a i a fu re te i ku wa to me ru ko to wa de ki na i"
				}
			],
