		},
		{
			"text": "赤い",
			"startTime": 301460,
			"endTime": 302410,
			"translations": [
				{
					"language": "en",
					"text": "Red"
				},
				{
					"language": "zh-Hans",
					"text": "好红"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "a ka i"
				}
			],
			"id": "L172",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 15
		},
		{
			"text": "殺してあげる",
			"startTime": 307250,
			"endTime": 308200,
			"translations": [
				{
					"language": "en",
					"text": "I’ll kill you!"
				},
				{
					"language": "zh-Hans",
					"text": "让我杀了你！"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "ko ro shi te a ge ru"
				}
			],
			"id": "L173",
			"agentId": "v1",
			"songPart": "Verse",
			"blockIndex": 15
		},
		{
			"text": "其ノ生を引き裂かれて 赤銀を吐き消し飛べ",
			"startTime": 308210,
			"endTime": 314800,
			"translations": [
				{
					"language": "en",
					"text": "Your life is torn apart, you spit up something red and silver and they spray away"
				},
				{
					"language": "zh-Hans",
					"text": "就算把这具身体撕裂 只有赤银烟雾扩散"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "so no se i o hi ki sa ka re te se ki gin o ha ki ke shi to be"
				}
			],
			"id": "L174",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 16
		},
		{
			"text": "其ノ生の華散らして 極彩に咲き我が糧に",
			"startTime": 314910,
			"endTime": 321090,
			"translations": [
				{
					"language": "en",
					"text": "I scatter the flower of your life, blooming in rich colors, and turn you into my food"
				},
				{
					"language": "zh-Hans",
					"text": "让那具身体四分五裂 绽放鲜艳的色彩即我的粮食"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "so no se i no ha na chi ra shi te go ku se i ni sa ki wa ga ka te ni"
				}
			],
			"id": "L175",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 16
		},
		{
			"text": "其ノ生がお前ならば 喰らい尽くして血肉にす",
			"startTime": 321290,
			"endTime": 327600,
			"translations": [
				{
					"language": "en",
					"text": "If your life is you, then I’ll eat you up into flesh and blood"
				},
				{
					"language": "zh-Hans",
					"text": "如果那具身体就是你 我会将肉都吃得干干净净"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "so no se i ga o ma e na ra ba ku ra i tsu ku shi te chi ni ku ni su"
				}
			],
			"id": "L176",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 16
		},
		{
			"text": "其ノ四肢を贄と捧げ 我が足元の死屍となれ",
			"startTime": 327700,
			"endTime": 334600,
			"translations": [
				{
					"language": "en",
					"text": "I’ll offer up your limbs as sacrifice- Become the corpse at my feet"
				},
				{
					"language": "zh-Hans",
					"text": "把四肢作为供物 让你成为我脚边的死尸"
				}
			],
			"romanizations": [
				{
					"language": "ja-Latn",
					"text": "so no shi shi o ni e to sa sa ge wa ga a shi mo to no shi shi to na re"
				}
			],
			"id": "L177",
			"agentId": "v1",
			"songPart": "Chorus",
			"blockIndex": 16
		}
	]
