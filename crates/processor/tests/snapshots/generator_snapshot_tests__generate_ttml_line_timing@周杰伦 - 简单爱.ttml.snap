                    <transliteration xml:lang="zh-Latn-pinyin">
                        <text for="L1">shuo bu shang wei shen me wo bian de hen zhu dong</text>
                        <text for="L2">ruo ai shang yi ge ren shen me du hui zhi de qu zuo</text>
