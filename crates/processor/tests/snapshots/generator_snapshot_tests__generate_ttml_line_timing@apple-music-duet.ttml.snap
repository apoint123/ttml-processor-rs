            <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
                <translations>
                    <translation xml:lang="zh-Hans">
                        <text for="L1">我们不提布鲁诺 不 不 不</text>
                        <text for="L2">我们不提布鲁诺 可是</text>
                        <text for="L3">那天是我结婚的日子</text>
                        <text for="L4">我们在做准备 天空万里无云</text>
                        <text for="L5">布鲁诺坏笑着走了进来</text>
                        <text for="L6">你讲还是我讲</text>
                        <text for="L7">布鲁诺说 看来要下雨</text>
                        <text for="L8">那样做让我心绪难宁</text>
                        <text for="L9">在狂风骤雨的天气结婚</text>
                        <text for="L10">我们不提布鲁诺 不 不 不</text>
                        <text for="L11">我们不提布鲁诺</text>
                        <text for="L12">嘿 从小就害怕布鲁诺开口讲话</text>
                        <text for="L13">我总是能听到他喃喃自语</text>
                        <text for="L14">想起他 我就想到沙子滑落的声音</text>
                        <text for="L15">这份令人谦卑的天赋太沉重</text>
                        <text for="L16">总是让奶奶和家人手足无措</text>
                        <text for="L17">让他们面对无法理解的预言</text>
                        <text for="L18">你懂吗</text>
                        <text for="L19">身高七尺 背上爬老鼠</text>
                        <text for="L20">他若唤你名字 万物隐进黑暗</text>
                        <text for="L21">没错 他潜入你梦境 乐见你尖叫</text>
                        <text for="L22">我们不提布鲁诺 不 不 不</text>
                        <text for="L23">我们不提布鲁诺</text>
                        <text for="L24">他说我的鱼会死 第二天鱼真的死了</text>
                        <text for="L25">他说我会发福 让他说中了</text>
                        <text for="L26">他说我会头秃 结果你看看我的头</text>
                        <text for="L27">预言既出 命中注定</text>
                        <text for="L28">他说我梦想的生活</text>
                        <text for="L29">将会成真 终有一天属于我</text>
                        <text for="L30">他说我的力量会增长</text>
                        <text for="L31">像藤上茁壮成长的葡萄</text>
                        <text for="L32">他说我的梦中情人</text>
                        <text for="L33">终将遥不可及</text>
                        <text for="L34">会与别人订婚</text>
                        <text for="L35">仿佛我现在就听到他说话</text>
                        <text for="L36">嘿 妹妹 我不想听到你出声</text>
                        <text for="L37">仿佛我现在就能听到他说话</text>
                        <text for="L38">我现在就能听到他说话</text>
                        <text for="L39">呃 布鲁诺</text>
                        <text for="L40">没错 说到那个布鲁诺</text>
                        <text for="L41">我真的需要了解布鲁诺</text>
                        <text for="L42">告诉我真相 全部真相 布鲁诺</text>
                        <text for="L43">晚宴时间到</text>
                        <text for="L44">身高七尺 背上爬老鼠</text>
                        <text for="L45">他若唤你名字 万物隐进黑暗</text>
                        <text for="L46">天空不许有一朵云</text>
                        <text for="L47">没错 他潜入你梦境 乐见你尖叫</text>
                        <text for="L48">你讲还是我讲</text>
                        <text for="L49">喂 马里亚诺在路上</text>
                        <text for="L50">布鲁诺说 看来要下雨</text>
                        <text for="L51">他为何说出来</text>
                        <text for="L52">那样做让我心绪难宁</text>
                        <text for="L53">在狂风骤雨的天气结婚</text>
                        <text for="L54">他来了</text>
                        <text for="L55">不提布鲁诺</text>
                        <text for="L56">我为何提起布鲁诺</text>
                        <text for="L57">绝口不提布鲁诺</text>
                        <text for="L58">我真不该提起布鲁诺</text>
                    </translation>
                </translations>
